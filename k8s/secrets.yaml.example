# Passo 11: modelo dos Secrets com as senhas dos bancos (equivalente ao .env.example do compose).
# Copie para secrets.yaml (não versionado, está no .gitignore) e troque as senhas:
#   Copy-Item k8s/secrets.yaml.example k8s/secrets.yaml
#   kubectl apply -f k8s/secrets.yaml
# A extensão .example faz o "kubectl apply -f k8s/" ignorar este arquivo: ele só lê .yaml, .yml e .json.
# Cada Secret é lido pelo banco (POSTGRES_PASSWORD) e pela API (DB_PASSWORD, que entra na connection string).
apiVersion: v1
kind: Secret
metadata:
  name: rates-db
  namespace: minicambio
type: Opaque
stringData: # texto puro; o Kubernetes guarda em base64 no campo "data"
  password: TROQUE-AQUI
---
apiVersion: v1
kind: Secret
metadata:
  name: payments-db
  namespace: minicambio
type: Opaque
stringData:
  password: TROQUE-AQUI
---
apiVersion: v1
kind: Secret
metadata:
  name: orders-db
  namespace: minicambio
type: Opaque
stringData:
  password: TROQUE-AQUI
