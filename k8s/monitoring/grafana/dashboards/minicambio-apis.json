{
  "uid": "minicambio-apis",
  "title": "MiniCâmbio - APIs",
  "description": "Passo 27.7: tráfego, respostas, latência e recursos das 3 APIs, por ambiente. Os health checks e o /metrics ficam de fora das contas de tráfego.",
  "tags": ["minicambio"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Ambiente",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"kubernetes-pods\"}, namespace)", "refId": "ns" },
        "definition": "label_values(up{job=\"kubernetes-pods\"}, namespace)",
        "refresh": 1,
        "current": { "text": "minicambio", "value": "minicambio" },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods coletados por API",
      "description": "Quantos Pods de cada API o Prometheus está coletando agora (acompanha o HPA).",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (app) (up{job=\"kubernetes-pods\", namespace=\"$namespace\"} == 1)",
          "legendFormat": "{{app}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requisições por segundo, por API",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Respostas por código de status",
      "description": "2xx = sucesso; 404 = não encontrado; 422 = regra de negócio (DomainException); 5xx = falha do servidor.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app, http_response_status_code) (rate(http_server_request_duration_seconds_count{namespace=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência p95, por API",
      "description": "95% das requisições levaram até este tempo. Calculado a partir dos 'baldes' (buckets) do histograma.",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_server_request_duration_seconds_bucket{namespace=\"$namespace\", http_route!~\"/health/.*|/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU por Pod (núcleos)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memória por Pod",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    }
  ]
}
