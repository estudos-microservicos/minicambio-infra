# Passo 26.8: gerado pelo configMapGenerator da k8s/base/kustomization.yaml (nome com hash; ver orders/orders-api.env).
# Antes, o ConfigMap no fim do rates-api.yaml. O PROD troca o ambiente para Production (overlays/prod).
ASPNETCORE_ENVIRONMENT=Development
# quem migra é o Job rates-migrations; o "false" explícito vence o "true" do appsettings.Development.json
Database__ApplyMigrationsOnStartup=false
# Passo 22: 5 min de cache da taxa ao vivo (o padrão da API, aqui explícito)
Rates__LiveRateCacheSeconds=300
