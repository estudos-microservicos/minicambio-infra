# Passo 11: modelo dos Secrets com as senhas dos bancos (equivalente ao .env.example do compose).
# Copie para secrets.yaml (não versionado, está no .gitignore) e troque as senhas:
#   Copy-Item k8s/base/secrets.yaml.example k8s/base/secrets.yaml
#   (Passo 26: ele entra no "kubectl apply -k k8s/overlays/<ambiente>", pela lista da base)
# A extensão .example é só para lembrar que é um modelo; a kustomization.yaml da base não o lista.
# Cada Secret é lido pelo banco (POSTGRES_PASSWORD) e pela API (DB_PASSWORD, que entra na connection string).
# Passo 22: o rates-cache é lido pelo Redis (REDISCLI_AUTH) e pelo rates-api (REDIS_PASSWORD).
apiVersion: v1
kind: Secret
metadata:
  name: rates-db
  namespace: minicambio
type: Opaque
stringData: # texto puro; o Kubernetes guarda em base64 no campo "data"
  password: TROQUE-AQUI
---
apiVersion: v1
kind: Secret
metadata:
  name: payments-db
  namespace: minicambio
type: Opaque
stringData:
  password: TROQUE-AQUI
---
apiVersion: v1
kind: Secret
metadata:
  name: orders-db
  namespace: minicambio
type: Opaque
stringData:
  password: TROQUE-AQUI
---
apiVersion: v1
kind: Secret
metadata:
  name: rates-cache # Passo 22: senha do Redis do Rates (lida pelo Redis e pelo rates-api)
  namespace: minicambio
type: Opaque
stringData:
  password: TROQUE-AQUI
