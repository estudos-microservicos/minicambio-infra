# Passo 26.8: gerado pelo configMapGenerator da k8s/base/kustomization.yaml (nome com hash; ver orders/orders-api.env).
# Antes, o ConfigMap no fim do kafka.yaml. A imagem converte cada KAFKA_X_Y em x.y do server.properties.
# id fixo do cluster, o mesmo do compose (kafka-storage.sh random-uuid)
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
# KAFKA_ADVERTISED_LISTENERS saiu daqui no Passo 33.1: está no "env" do kafka.yaml, porque depende do namespace
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
# os tópicos são criados pelo Job kafka-topics
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
