# Passo 26.6: a configuração não sigilosa do orders-api (antes, o ConfigMap no fim do orders-api.yaml).
# O configMapGenerator da base (k8s/base/kustomization.yaml) transforma este arquivo no ConfigMap
# "orders-api-<hash>"; o hash muda quando um valor muda, e com ele o Deployment, que então recria os Pods.
# Equivalente no compose: um arquivo lido por "env_file:". Formato CHAVE=valor, sem aspas (tudo vira texto).
ASPNETCORE_ENVIRONMENT=Development
# quem migra é o Job orders-migrations; o "false" explícito vence o "true" do appsettings.Development.json
Database__ApplyMigrationsOnStartup=false
# nome do Service do Rates
Services__RatesApi=http://rates-api:8080
# Passo 21: nome do Service do Kafka (o Payments agora é falado por ele)
Kafka__BootstrapServers=kafka:9092
